{
  "name": "burr-memory",
  "version": "0.1.0",
  "description": "Local debugging memory for coding agents. Search before guess. Capture reusable failures. Playbook after verify.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sansynx/burr-memory.git"
  },
  "homepage": "https://github.com/sansynx/burr-memory#readme",
  "bugs": {
    "url": "https://github.com/sansynx/burr-memory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "burr": "dist/cli/index.js"
  },
  "main": "./.opencode/plugins/burr.mjs",
  "exports": {
    ".": "./.opencode/plugins/burr.mjs",
    "./api": "./dist/index.js",
    "./cli": "./dist/cli/index.js",
    "./codex": "./dist/codex/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./learning": "./dist/learning/index.js"
  },
  "files": [
    "dist",
    "skills/burr/SKILL.md",
    "skills/burr-search/SKILL.md",
    "skills/burr-capture/SKILL.md",
    "skills/burr-resolve/SKILL.md",
    "skills/burr-promote/SKILL.md",
    "skills/burr-audit/SKILL.md",
    "skills/burr-help/SKILL.md",
    "templates/config.json",
    "templates/global-instructions.md",
    "templates/instructions.md",
    "assets/burr-mark.svg",
    "assets/burr-how-it-works.svg",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    ".opencode/plugins/burr.mjs",
    "pi-extension/index.ts",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "hooks/codex.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.pi.json",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run build && npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "burr",
    "debugging",
    "memory",
    "skills",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi-extension/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
