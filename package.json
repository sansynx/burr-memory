{
  "name": "burr-memory",
  "version": "0.1.0",
  "description": "Local debugging memory for coding agents. Search before guess. Capture reusable failures. Playbook after verify.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "burr": "dist/cli/index.js"
  },
  "main": "./.opencode/plugins/burr.mjs",
  "exports": {
    ".": "./.opencode/plugins/burr.mjs",
    "./cli": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "templates",
    "assets",
    ".claude-plugin",
    ".codex-plugin",
    ".opencode/plugins/burr.mjs",
    "pi-extension",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.pi.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "burr",
    "debugging",
    "memory",
    "skills",
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./pi-extension/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
